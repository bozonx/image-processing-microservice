###### Basic app settings

# Application environment: development | production | test.
NODE_ENV=production
# Address the HTTP server binds to.
LISTEN_HOST=0.0.0.0
# Port the HTTP server binds to.
LISTEN_PORT=8080
# Optional path prefix; leave empty to serve at /api/v1.
# BASE_PATH=
# Enables the bundled browser UI. It is an unauthenticated development demo and cannot be
# combined with configured authentication — the service refuses to start if you try.
ENABLE_UI=false
# Pino log level: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=warn
# Application timezone.
TZ=UTC
# Optional service-name override used in logs and health.
SERVICE_NAME="image-processing-microservice"
# Optional service-version override used in logs and health.
# SERVICE_VERSION=
# Seconds to remain observable as shutting_down before closing.
SHUTDOWN_DRAIN_SECONDS=5
# Seconds to wait for a clean close before exiting with a failure status. Guards against a
# shutdown that never finishes — an in-flight image task that never settles would otherwise
# hang until the orchestrator SIGKILLs the container, which is reported as a clean stop. Keep
# SHUTDOWN_DRAIN_SECONDS + SHUTDOWN_FORCE_EXIT_SECONDS below stop_grace_period.
SHUTDOWN_FORCE_EXIT_SECONDS=10

###### Authentication
# This service is called by other services, not by end users. Callers authenticate with a named
# Bearer token; health stays public for probes, everything else requires a credential.
# Comma-separated accepted Bearer credentials, each as `name:token`. The name identifies the
# calling service in logs and lets one caller be revoked on its own; it is not a secret.
# An entry without a name is rejected at startup.
# AUTH_BEARER_TOKENS=svc-example:replace-with-a-real-token
# Basic auth is part of the fleet standard but has no consumer here. Both values must be set
# together for it to be enabled.
# AUTH_BASIC_USER=
# AUTH_BASIC_PASS=

###### Processing limits and defaults
# Maximum uploaded file size in MiB. This bounds the compressed upload, not what it decodes to.
FILE_MAX_BYTES_MB=100
# Hard ceiling on the pixel count of a decoded input; guards against decompression bombs, which
# FILE_MAX_BYTES_MB cannot catch. Budget ~4 bytes per pixel per concurrent task and keep the
# product below the container memory limit: 25M x 4 B x MAX_CONCURRENCY=4 is ~400 MiB.
IMAGE_MAX_INPUT_PIXELS=25000000
# Hard ceiling on the width and height of a returned image; 0 disables it, 8192 is the most any
# configuration may allow. This is a limit, not a default: a request asking for more is rejected,
# and an image with no resize of its own is scaled down to fit inside it.
IMAGE_MAX_DIMENSION=3840
# Number of concurrent processing tasks.
MAX_CONCURRENCY=4
# Maximum queued tasks; 0 means unlimited.
QUEUE_MAX_SIZE=100
# Maximum task execution duration in seconds (after being dequeued).
QUEUE_TIMEOUT_SECONDS=30
# Total request timeout in seconds (including queue wait time and task execution).
REQUEST_TIMEOUT_SECONDS=60
# Default output image format: webp | avif | jpeg | png | gif | tiff | raw.
IMAGE_DEFAULT_FORMAT=webp
