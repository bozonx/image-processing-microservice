###### Basic app settings

# Application environment: development | production | test.
NODE_ENV=development
# Address the HTTP server binds to.
LISTEN_HOST=localhost
# Port the HTTP server binds to.
LISTEN_PORT=8080
# Optional path prefix; leave empty to serve at /api/v1.
# BASE_PATH=
# Enables the bundled browser UI.
ENABLE_UI=true
# Pino log level: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=debug
# Application timezone.
TZ=UTC
# Optional service-name override used in logs and health.
# SERVICE_NAME=
# Optional service-version override used in logs and health.
# SERVICE_VERSION=
# Seconds to remain observable as shutting_down before closing.
SHUTDOWN_DRAIN_SECONDS=5

###### Authentication
# Basic auth is enabled only when both values are set.
# AUTH_BASIC_USER=
# AUTH_BASIC_PASS=
# Comma-separated accepted Bearer tokens.
# AUTH_BEARER_TOKENS=

###### Processing limits and defaults
# Maximum uploaded file size in MiB.
FILE_MAX_BYTES_MB=100
# Number of concurrent processing tasks.
MAX_CONCURRENCY=4
# Maximum queued tasks; 0 means unlimited.
QUEUE_MAX_SIZE=100
# Maximum queue wait in seconds.
QUEUE_TIMEOUT_SECONDS=30
# Total request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=60
# Default output image format: webp | avif | jpeg | png | gif | tiff | raw.
# IMAGE_DEFAULT_FORMAT=webp
